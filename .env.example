# Oeffentliche Basis-URL, unter der Readwise den Dienst erreicht (Reverse Proxy!)
PUBLIC_BASE_URL=https://reader.example.org

# Geheimes Pfadsegment des Feeds: https://<host>/feed/<FEED_SECRET>.xml
# z. B. mit `openssl rand -hex 16` erzeugen
FEED_SECRET=change-me

# Quellen (OJS-Zeitschriften) stehen in sources.toml, nicht hier.
SOURCES_FILE=sources.toml
FEED_TITLE=OJS-Zeitschriften – Volltext

# Abfrageintervall in Sekunden (Default 6 Stunden)
POLL_INTERVAL_SECONDS=21600
MAX_ARTICLES_PER_POLL=5

# Optional: Artikel zusaetzlich direkt in Readwise Reader anlegen
READWISE_PUSH=false
READWISE_TOKEN=
READWISE_LOCATION=feed
# Tags pro Quelle: readwise_tags in sources.toml (Default: Quellen-Schluessel)

# docling-Threads (an CPU-Kerne anpassen)
DOCLING_THREADS=4

# Host-Port, auf dem der Dienst erreichbar ist
HOST_PORT=8080
